# Local Magic eSIM promo/affiliate context
PROJECT_CONTEXT.md

# Токены источников. Репозиторий публичный: .env здесь — это опубликованный
# секрет, а не локальный файл. Отдельно .env.example — он специально пустой и
# коммитится как образец.
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Content Intelligence
# ---------------------------------------------------------------------------
# Репозиторий ПУБЛИЧНЫЙ и раздаётся целиком через GitHub Pages: любой файл здесь
# — это публичный URL. Поэтому внутренние измерения в git не попадают вообще.
#
# seo/intel/data/       выручка, прибыль, заказы по странам, снимки, отчёты
# seo/intel/data-demo/  синтетика для проверки механики — не должна иметь ни
#                       одного способа оказаться рядом с боевыми данными
seo/intel/data/
seo/intel/data-demo/

# Панель Content Intelligence Center собирается ВНЕ репозитория; это на случай,
# если кто-то переопределит INTEL_OUT и промахнётся.
content-intelligence/
seo/intel/report/

# Старый отчёт прежнего Quality Score — заменён на seo/intel/data/dashboard.json
seo/content-dashboard.json

# Playwright screenshots from test/mini-app/ui.e2e.js — artefacts, not source.
test/mini-app/.shots/

# ---------------------------------------------------------------------------
# Node modules and browser-test artefacts
# ---------------------------------------------------------------------------
# This matters more here than in an ordinary repository. Pages serves this repo
# WHOLESALE and `.nojekyll` disables every default exclusion, so anything
# committed becomes a public URL — an 18 MB dependency tree included. The site
# itself still has no build step and no runtime dependency; `package.json`
# exists only to pin the browser test runner.
node_modules/
/test-results/
/playwright-report/
/blob-report/
.playwright-mcp/

# ---------------------------------------------------------------------------
# Local tooling artefacts — moved here so the protection TRAVELS.
# ---------------------------------------------------------------------------
# These three were ignored only by rules that are not part of the repository:
# `.git/info/exclude`, which is never cloned and never pushed, and the
# user-global `~/.config/git/ignore`, which exists on one machine for one
# account. A clone therefore arrived with NO protection for them at all, and on
# any second checkout a plain `git add -A` would have staged them into a PUBLIC
# repository (run-2 R2-10).
#
# `.claude/settings.local.json` is the one that matters: Claude Code recreates
# it automatically, so it reappears on every machine without anyone deciding to
# create it.
#
# `*RENDER_API_KEY*` matches no file today and is kept as forward-looking
# insurance: deployment credentials have no business in a public repository, and
# a pattern costs nothing.
#
# NOT `.claude/` wholesale, deliberately: `.claude/skills/**` is tracked on
# purpose (project-scoped agent skills, shared through the repo). A broad rule
# would leave the existing ten tracked while hiding any new one from `git add`,
# which is the most confusing state available.
.claude/settings.local.json
.claude/RESUME.md
*RENDER_API_KEY*
