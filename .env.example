# Образец. Настоящие значения кладутся в .env, который в .gitignore.
# Значения токенов никогда не выводятся в терминал, логи и отчёты.

# --- Яндекс Метрика (подключаем первым) ---------------------------------
# OAuth-токен со scope metrika:read — и только с ним.
# Получить: https://oauth.yandex.ru → создать приложение → «Яндекс Метрика» →
# «Получение статистики, чтение параметров» (metrika:read).
YANDEX_METRIKA_TOKEN=
# Счётчик сайта. По умолчанию берётся 110393848 — тот, что стоит на страницах.
YANDEX_METRIKA_COUNTER=110393848

# --- Пока не подключаем -------------------------------------------------
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
# GSC_SITE_URL=
# YANDEX_WEBMASTER_TOKEN=
# YANDEX_WEBMASTER_USER_ID=
# YANDEX_WEBMASTER_HOST_ID=
