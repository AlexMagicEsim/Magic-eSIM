{
  "about": "Where every country flag under assets/flags/ comes from, and the sha256 of each SVG as shipped. seo/test-flags.mjs fails on any file that differs from its entry, on a file without an entry and on an entry without a file: a flag is replaced on purpose, with this file, never silently.",
  "source": {
    "package": "flag-icons",
    "repository": "https://github.com/lipis/flag-icons",
    "license": "MIT — assets/flags/LICENSE.txt",
    "set": "flags/4x3",
    "viewBox": "0 0 640 480",
    "reference_version": "7.5.0",
    "reference_url": "https://cdn.jsdelivr.net/npm/flag-icons@7.5.0/flags/4x3/<code>.svg"
  },
  "origins": {
    "flag-icons@7.5.0": "The original file of flag-icons 7.5.0, byte for byte.",
    "minified-4a219e31": "Imported minified by storefront 4a219e31 (2026-10-10, shared design system); the flag-icons version was not recorded. Every coordinate was rounded to a whole unit. Checked 2026-10-19 against 7.5.0 pixel by pixel and by eye at 300 px: no visible difference except simplified fine detail (e.g. the Bhutan dragon's scales)."
  },
  "history": [
    {
      "date": "2026-10-10",
      "commit": "4a219e31",
      "change": "198 SVG flags imported, minified with whole-unit coordinates."
    },
    {
      "date": "2026-10-19",
      "change": "cn nz hn cw gw gt gd replaced by the flag-icons 7.5.0 originals: the rounding had flattened or erased their stars (China, Honduras, Curaçao, New Zealand, Guinea-Bissau, Grenada) and broken the Guatemalan emblem."
    }
  ],
